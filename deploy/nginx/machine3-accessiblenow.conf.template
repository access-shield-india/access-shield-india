# Managed by accessiblenow deploy/ — machine3 host nginx
# Web :3000, API :4000, Keycloak :8080 (auth subdomain)

upstream accessiblenow_web {
    server 127.0.0.1:{{WEB_PORT}};
    keepalive 16;
}
upstream accessiblenow_api {
    server 127.0.0.1:{{API_PORT}};
    keepalive 16;
}
upstream accessiblenow_keycloak {
    server 127.0.0.1:{{KEYCLOAK_PORT}};
    keepalive 8;
}

# App + API (same origin; /api/v1 → Express, everything else → Next)
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} {{DOMAIN_WWW}};

    client_max_body_size 100M;

    # Express API (also reachable via Next rewrite; direct is better for uploads)
    location /api/v1/ {
        proxy_pass http://accessiblenow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
    }

    # API health (host process listens on /health, not under /api/v1)
    location = /health {
        proxy_pass http://accessiblenow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Next.js web (includes /api/auth Auth.js, /auth/callback, pages)
    location / {
        proxy_pass http://accessiblenow_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}

# Keycloak (OIDC) — separate hostname
server {
    listen 80;
    listen [::]:80;
    server_name {{AUTH_DOMAIN}};

    client_max_body_size 20M;

    location / {
        proxy_pass http://accessiblenow_keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_read_timeout 300s;
    }
}
